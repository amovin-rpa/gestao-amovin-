{
  "builds": [
    {
      "src": "v2-segura/public/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/v2-segura/public/index.html"
    },
    {
      "source": "/pre-cadastro-externo.html",
      "destination": "/v2-segura/public/pre-cadastro-externo.html"
    },
    {
      "source": "/(.*)",
      "destination": "/v2-segura/public/$1"
    }
  ]
}
